# ------------------------------------------------------------
# Novari API — variáveis de ambiente
# Copie este ficheiro para .env e preencha. NUNCA faça commit do .env.
# ------------------------------------------------------------

# Porta HTTP do servidor
PORT=3000

# development | production | test
NODE_ENV=development

# Banco de dados.
#   Vazio  -> SQLite local em backend/database/novari.sqlite
#   SQLite -> sqlite:./database/novari.sqlite
#   Postgres (futuro, requer "npm install pg") -> postgres://utilizador:senha@host:5432/novari
DATABASE_URL=

# Origens do navegador autorizadas a chamar a API (separadas por vírgula).
# Vazio em desenvolvimento -> localhost:3000, :5500 (Live Server) e :8080.
CORS_ORIGINS=

# Servir o site (index.html, configurador.html…) a partir deste servidor
SERVE_FRONTEND=true

# Chave da API de IA (Anthropic). Sem chave, o planejador usa o interpretador local.
AI_API_KEY=
AI_MODEL=claude-opus-5
# Profundidade de raciocínio: low | medium | high
AI_EFFORT=medium
# Pedidos à IA por minuto, por IP
AI_RATE_LIMIT_PER_MIN=20

# Endereço público desta API (links da ficha do marceneiro no email).
# No Render fica automático (RENDER_EXTERNAL_URL).
PUBLIC_URL=http://localhost:3000
# Endereço do site com o configurador (link do 3D interativo). Vazio -> PUBLIC_URL
SITE_URL=

# Email da Novari que recebe os projetos
NOVARI_EMAIL=novarimobiliarioexclusivo@gmail.com

# Envio do email com a ficha do marceneiro (vistas 3D + medidas). Use UM:
#  a) Resend (API HTTP; obrigatório no Render gratuito, que bloqueia SMTP)
RESEND_API_KEY=
#  b) SMTP, ex. Gmail: smtp.gmail.com, 465, o endereço e uma "senha de app"
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# Remetente. Vazio -> Resend: onboarding@resend.dev | SMTP: SMTP_USER
EMAIL_FROM=

# Chave das rotas de administração (listar projetos/clientes, histórico, apagar).
# Em produção, sem chave, essas rotas ficam fechadas. Envie: Authorization: Bearer <chave>
ADMIN_TOKEN=

# error | warn | info | debug | silent
LOG_LEVEL=info
